# این فایل را با نام .env کپی کنید و مقدارها را پر کنید. .env را هرگز برای کسی نفرستید.
WP_SITE_URL=https://zafaranmarket.com
WP_USER=editoruser
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxx
REQUEST_TIMEOUT=30

# ---- AI (any OpenAI-compatible gateway; copy these 5 values from the provider's docs/dashboard) ----
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=xxxx
LLM_MODEL=model-name-from-pricing-page
# قیمت هر یک میلیون توکن (دلار) از صفحهٔ قیمت‌ها؛ برای محاسبهٔ هزینه و سقف بودجه
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0
# سقف هزینهٔ ماهانهٔ این برنامه (دلار). برای اعتبار آزمایشی ۰٫۲ دلاری حدود ۰٫۱۵ بگذارید
LLM_BUDGET_USD=0.15
LLM_MAX_OUTPUT_TOKENS=1500
LLM_MAX_TOKENS_PER_RUN=60000
