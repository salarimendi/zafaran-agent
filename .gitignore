# ===== secrets (never commit) =====
.env
.env.*
!.env.example

# ===== Python / environment =====
__pycache__/
*.pyc
.venv/
ZAFVENV/
build/

# ===== everything the app generates or downloads (site data, search data, AI cache, logs, backups) =====
logs/
reports/
proposals/
backups/
cache/
*.lock
panel.port

# knowledge/: ignore all of it (site snapshot, exported articles, Search Console data, style pack)
# EXCEPT the two files you edit by hand and want versioned:
knowledge/*
!knowledge/new_terms.yaml
!knowledge/style/
knowledge/style/*
!knowledge/style/style_guide.md
!knowledge/style/style_pack.md
!knowledge/keywords/
knowledge/keywords/*
!knowledge/keywords/occasions.yaml
!knowledge/keywords/manual.txt

# ===== your working inbox (keep only the samples / folder markers) =====
inbox/products/*
!inbox/products/_sample/
inbox/articles/*
!inbox/articles/_sample.md
inbox/images/
inbox/searchconsole/*
!inbox/searchconsole/.keep
result.json
*.result.json

# ===== archives and temp files =====
*.zip
*.bak
*.tmp

# ===== editors / OS =====
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
